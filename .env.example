# Insighta backend environment — copy to .env and fill in.
# Key names only; never commit real values. Quick Start (README) minimum set is
# marked [required]; everything else has a safe default or gates an optional
# feature (unset = feature off).

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3000
CORS_ORIGIN=http://localhost:8081
LOG_LEVEL=info
LOG_DIR=./logs
DATA_DIR=./data
CACHE_DIR=./cache

# ── Database (Supabase Postgres) [required] ─────────────────────────────────
# DATABASE_URL = transaction pooler (6543) · DIRECT_URL = session (5432, DDL)
DATABASE_URL=postgresql://user:password@127.0.0.1:6543/postgres
DIRECT_URL=postgresql://user:password@127.0.0.1:5432/postgres
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ── Auth [required] ──────────────────────────────────────────────────────────
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
ENCRYPTION_SECRET=32-byte-random-string

# ── YouTube Data API [required] ─────────────────────────────────────────────
YOUTUBE_API_KEY=your-youtube-api-key
YOUTUBE_CLIENT_ID=your-oauth-client-id
YOUTUBE_CLIENT_SECRET=your-oauth-client-secret
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/v1/youtube/callback

# ── LLM providers (features degrade gracefully when unset) ──────────────────
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=
MANDALA_GEN_MODEL=
MANDALA_GEN_URL=
MANDALA_EMBED_MODEL=
MANDALA_EMBED_DIMENSION=4096

# ── Billing (Lemon Squeezy, optional) ───────────────────────────────────────
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_VARIANT_ID_PRO_MONTHLY=
LEMONSQUEEZY_VARIANT_ID_PRO_YEARLY=
LEMONSQUEEZY_VARIANT_ID_PRO_LIFETIME=

# ── Email (optional) ────────────────────────────────────────────────────────
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
GMAIL_SMTP_FROM=

# ── Narration (optional) ────────────────────────────────────────────────────
ELEVENLABS_API_KEY=

# ── Sync / quota tuning (defaults are sensible) ─────────────────────────────
DEFAULT_SYNC_INTERVAL=3600
MAX_CONCURRENT_SYNCS=3
RETRY_ATTEMPTS=3
BACKOFF_MULTIPLIER=2
DAILY_QUOTA_LIMIT=10000
QUOTA_WARNING_THRESHOLD=0.8
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000

# ── Misc (optional) ─────────────────────────────────────────────────────────
GITHUB_TOKEN=
INSIGHTA_BOT_KEY=
INSIGHTA_BOT_USER_ID=
