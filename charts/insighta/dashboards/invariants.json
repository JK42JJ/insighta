          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT model AS \"모델\", status AS \"상태\",\n       count(*) AS \"호출\",\n       round(sum(cost_usd)::numeric, 4) AS \"낭비\"\n  FROM llm_call_logs\n WHERE status <> 'success' AND created_at >= now() - interval '24 hours'\n GROUP BY model, status ORDER BY 4 DESC NULLS LAST"
